{
  "schema": 1,
  "title": "Chest",
  "groups": [
    {
      "id": "application",
      "label": "Your application"
    },
    {
      "id": "owner",
      "label": "First owner"
    },
    {
      "id": "mail",
      "label": "Email"
    }
  ],
  "fields": [
    {
      "name": "APP_NAME",
      "label": "Application name",
      "help": "The name shown in your new application.",
      "kind": "text",
      "required": true,
      "default": "Chest",
      "group": "application"
    },
    {
      "name": "PRIMARY_COLOR",
      "label": "Brand colour",
      "kind": "colour",
      "required": true,
      "default": "#356c60",
      "group": "application"
    },
    {
      "name": "OWNER_EMAIL",
      "label": "Owner email",
      "help": "The owner of this Chest. On your computer rer signs you in as the owner; a hosted Chest emails sign-in links to this address.",
      "kind": "email",
      "required": true,
      "prefill": "account-email",
      "group": "owner"
    },
    {
      "name": "SESSION_SECRET",
      "label": "Session secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SIGNING_KEY_SECRET",
      "label": "Signing key custody secret",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "input": "managed",
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "SETUP_TOKEN",
      "label": "Setup token",
      "kind": "secret",
      "required": true,
      "ownerVisible": false,
      "generate": "hex",
      "group": "owner"
    },
    {
      "name": "MAIL_PROVIDER",
      "label": "Mail provider",
      "kind": "select",
      "required": true,
      "default": "development",
      "options": [
        {
          "value": "rer",
          "label": "RER managed mail"
        },
        {
          "value": "resend",
          "label": "Resend"
        },
        {
          "value": "sendgrid",
          "label": "SendGrid"
        },
        {
          "value": "cloudflare",
          "label": "Cloudflare Email Sending"
        },
        {
          "value": "development",
          "label": "Local only (email off)"
        }
      ],
      "group": "mail",
      "help": "Choose Local only on your computer. Hosted installations require a configured email provider."
    },
    {
      "name": "MAIL_FROM",
      "label": "Sender address",
      "kind": "text",
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_RELAY_URL",
      "label": "Managed mail relay URL",
      "kind": "url",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "rer"
      },
      "group": "mail"
    },
    {
      "name": "MAIL_API_KEY",
      "label": "Mail API key",
      "kind": "secret",
      "input": "entered",
      "ownerVisible": true,
      "required": false,
      "presentations": [
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "rer"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "resend"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "sendgrid"
          },
          "required": true
        },
        {
          "when": {
            "field": "MAIL_PROVIDER",
            "equals": "cloudflare"
          },
          "required": true
        }
      ],
      "group": "mail"
    },
    {
      "name": "MAIL_ACCOUNT_ID",
      "label": "Cloudflare account ID",
      "kind": "text",
      "required": true,
      "when": {
        "field": "MAIL_PROVIDER",
        "equals": "cloudflare"
      },
      "group": "mail"
    }
  ],
  "steps": [
    {
      "type": "extension",
      "id": "branding"
    },
    {
      "type": "owner-claim",
      "mode": "signed",
      "emailField": "OWNER_EMAIL",
      "tokenField": "SETUP_TOKEN",
      "path": "/auth/owner-claim"
    }
  ],
  "business": {
    "settings": 1,
    "values": [
      "display_name"
    ],
    "team": {
      "roles": {
        "admin": "admin",
        "member": "member"
      }
    }
  }
}
