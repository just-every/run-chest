{
  "version": 1,
  "project": "documents/chest",
  "compatibilityDate": "2026-09-08",
  "compatibilityFlags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "d1": [
    {
      "binding": "DB"
    }
  ],
  "originVar": "AUTH_ORIGIN",
  "vars": {
    "AUTH_LOCAL": "false",
    "MAIL_PROVIDER": "resend"
  },
  "secrets": [
    {
      "binding": "OWNER_EMAIL",
      "environment": "OWNER_EMAIL"
    },
    {
      "binding": "SESSION_SECRET",
      "environment": "SESSION_SECRET"
    },
    {
      "binding": "SETUP_TOKEN",
      "environment": "SETUP_TOKEN"
    },
    {
      "binding": "MAIL_API_KEY",
      "environment": "MAIL_API_KEY"
    },
    {
      "binding": "CONTENT_SCANNER_URL",
      "environment": "CONTENT_SCANNER_URL",
      "optional": true,
      "verifyStandIn": "https://scanner.example.invalid/scan"
    },
    {
      "binding": "CONTENT_SCANNER_TOKEN",
      "environment": "CONTENT_SCANNER_TOKEN",
      "optional": true
    },
    {
      "binding": "SIGNING_KEY_SECRET",
      "environment": "SIGNING_KEY_SECRET",
      "optional": true
    },
    {
      "binding": "SIGNING_KEY_PREVIOUS_SECRET",
      "environment": "SIGNING_KEY_PREVIOUS_SECRET",
      "optional": true
    },
    {
      "binding": "COLLABORA_URL",
      "environment": "COLLABORA_URL",
      "optional": true
    }
  ],
  "r2": [
    {
      "binding": "BLOBS"
    }
  ],
  "platforms": [
    "workers",
    "container"
  ],
  "container": {
    "engine": "workerd"
  },
  "deployGuide": "https://run-chest.com/docs/hosting",
  "crons": [
    "*/15 * * * *"
  ]
}
